NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://tutor:tutor@localhost:5432/ai_tutor?schema=public
REDIS_URL=redis://localhost:6379

# Anthropic API key — required for generation + diagnosis workers
ANTHROPIC_API_KEY=

# Set to "true" to run without ANTHROPIC_API_KEY, using deterministic
# local fixtures instead of live LLM calls. Useful for local dev / CI.
# Must be "false" in production.
USE_MOCK_LLM=true

JWT_SECRET=change-this-to-a-long-random-string

# Firebase Admin SDK credentials. Keep real values out of source control.
FIREBASE_PROJECT_ID=ai-tutor-ef427
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ai-tutor-ef427.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# URL of the SymPy verification microservice
VERIFICATION_SERVICE_URL=http://localhost:5001

MASTERY_ADVANCE_THRESHOLD=0.85
